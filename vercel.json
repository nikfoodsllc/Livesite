{
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"staging\" ]; then exit 1; else exit 0; fi",
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/optimoroute",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cart-reminders",
      "schedule": "*/5 * * * *"
    }
  ]
}
