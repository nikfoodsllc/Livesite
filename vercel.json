{
  "git": {
    "deploymentEnabled": {
      "shrey/*": false,
      "shrey/**": false
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/optimoroute",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cart-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/optimoroute-live",
      "schedule": "*/5 * * * *"
    }
  ]
}
